PUID=1000
PGID=1000
TZ=America/New_York

# Host ports
NEXTCLOUD_PORT=443
COLLABORA_PORT=9980

# Your computer/LAN address (no https://). install.sh can detect this.
NEXTCLOUD_HOST=192.168.1.50
COLLABORA_HOST=192.168.1.50

# Filled by configure-office.sh / install.sh
ALIASGROUP1=https://192.168.1.50:443
COLLABORA_DOMAIN_REGEX=192\.168\.1\.50
COLLABORA_SERVER_NAME=192.168.1.50:9980
DICTIONARIES=en_US
COLLABORA_ADMIN_PASSWORD=changeme
