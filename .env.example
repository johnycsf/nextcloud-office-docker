# Container engine: docker | podman (./manage.sh install will prompt)
CONTAINER_ENGINE=docker

# Image registry to pull images from. Set to a private registry if needed.
# Default: docker.io
IMAGE_REGISTRY=docker.io

TZ=America/New_York

# Host ports
# Host ports. Kept unique across johnycsf stacks (heimdall 8080, vaultwarden 8081)
# and >=1024 so rootless Podman can bind them. Docker users may set 80.
NEXTCLOUD_PORT=8082
COLLABORA_PORT=9980

# Your computer/LAN address (no http://). install.sh can detect this.
NEXTCLOUD_HOST=192.168.1.50
COLLABORA_HOST=192.168.1.50

# MariaDB (official Nextcloud docker + admin DB guidance)
# https://github.com/nextcloud/docker#using-an-external-database
# install.sh replaces changeme-* with random passwords on first run.
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
MYSQL_PASSWORD=changeme-user
MYSQL_ROOT_PASSWORD=changeme-root

# Optional Redis (official Nextcloud caching). Set by: ./install.sh --include-redis
# ENABLE_REDIS=yes

# Filled by configure-office.sh / install.sh
ALIASGROUP1=http://192.168.1.50:8082
COLLABORA_DOMAIN_REGEX=192\.168\.1\.50
COLLABORA_SERVER_NAME=192.168.1.50:9980
DICTIONARIES=en_US
COLLABORA_ADMIN_PASSWORD=changeme
