TZ=America/New_York

# Host ports
NEXTCLOUD_PORT=80
COLLABORA_PORT=9980

# Your computer/LAN address (no http://). install.sh can detect this.
NEXTCLOUD_HOST=192.168.1.50
COLLABORA_HOST=192.168.1.50

# MariaDB (official Nextcloud docker + admin DB guidance)
# https://github.com/nextcloud/docker#using-an-external-database
# install.sh replaces changeme-* with random passwords on first run.
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
MYSQL_PASSWORD=changeme-user
MYSQL_ROOT_PASSWORD=changeme-root

# Filled by configure-office.sh / install.sh
ALIASGROUP1=http://192.168.1.50:80
COLLABORA_DOMAIN_REGEX=192\.168\.1\.50
COLLABORA_SERVER_NAME=192.168.1.50:9980
DICTIONARIES=en_US
COLLABORA_ADMIN_PASSWORD=changeme
